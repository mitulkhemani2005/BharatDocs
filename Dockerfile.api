FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOST=0.0.0.0 \
    PORT=5000

WORKDIR /app

COPY requirements.txt ./
RUN python -m pip install --upgrade pip && python -m pip install -r requirements.txt

COPY backend ./backend
COPY scripts/prepare_offline_model.py ./scripts/prepare_offline_model.py
COPY config.json hindi_terms.json LICENSE.txt THIRD_PARTY_NOTICES.txt ./
COPY fonts ./fonts
RUN python scripts/prepare_offline_model.py

EXPOSE 5000
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "5000"]
