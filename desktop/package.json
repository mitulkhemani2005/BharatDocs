{
  "name": "bharatdocs-desktop",
  "version": "1.0.4",
  "description": "Offline English-to-Hindi PDF translator for Windows",
  "author": "Mitul Khemani",
  "copyright": "Copyright © 2026 Mitul Khemani",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build:windows": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bharatdocs.translator",
    "productName": "BharatDocs",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "package.json",
      "assets/bharatdocs.ico"
    ],
    "extraResources": [
      { "from": "../.build/backend/desktop_backend", "to": "backend" },
      { "from": "../frontend/.next-desktop", "to": "frontend/out" },
      { "from": "../models/indicxlit-en-hi", "to": "models/indicxlit-en-hi" },
      { "from": "../hindi_terms.json", "to": "hindi_terms.json" },
      { "from": "../fonts", "to": "fonts" },
      { "from": "../LICENSE.txt", "to": "LICENSE.txt" },
      { "from": "../THIRD_PARTY_NOTICES.txt", "to": "THIRD_PARTY_NOTICES.txt" }
    ],
    "win": {
      "icon": "assets/bharatdocs.ico",
      "target": ["nsis"],
      "artifactName": "BharatDocs-Setup-${version}.${ext}"
    },
    "nsis": {
      "license": "../LICENSE.txt",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
